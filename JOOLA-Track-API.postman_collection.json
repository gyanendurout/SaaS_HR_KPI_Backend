{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "JOOLA Track API",
    "description": "Complete Phase 1 API collection for JOOLA Track KPI Management Platform.\n\n**Setup:**\n1. Set the `baseUrl` variable (default: http://localhost:4000)\n2. Run **Auth > Login** — the JWT token is saved automatically to `token`\n3. All other requests use `{{token}}` in the Authorization header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:4000", "type": "string" },
    { "key": "token",     "value": "",                      "type": "string" },
    { "key": "userId",    "value": "",                      "type": "string" },
    { "key": "kpiId",     "value": "",                      "type": "string" },
    { "key": "regionId",  "value": "",                      "type": "string" }
  ],
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "No auth required. Confirms the server is running."
          }
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.collectionVariables.set('token', res.data.access_token);",
                  "  pm.collectionVariables.set('userId', res.data.user.id);",
                  "  console.log('Token saved. User:', res.data.user.full_name);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@joola.in\",\n  \"password\": \"your_password_here\"\n}"
            },
            "description": "Returns JWT token. The test script auto-saves `access_token` → `{{token}}` and `user.id` → `{{userId}}`."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] },
            "description": "Returns the authenticated user's profile from the users table."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] },
            "description": "Invalidates the current JWT on Supabase Auth."
          }
        }
      ]
    },

    {
      "name": "Regions",
      "item": [
        {
          "name": "List Regions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.length > 0) {",
                  "  pm.collectionVariables.set('regionId', res.data[0].id);",
                  "  console.log('regionId saved:', res.data[0].name, res.data[0].code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/regions", "host": ["{{baseUrl}}"], "path": ["api","regions"] },
            "description": "Returns all 4 regions (APAC, IND, CHN, SEA). First region id is auto-saved to `{{regionId}}`."
          }
        },
        {
          "name": "Get Region by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/regions/{{regionId}}", "host": ["{{baseUrl}}"], "path": ["api","regions","{{regionId}}"] },
            "description": "Get a single region by UUID."
          }
        }
      ]
    },

    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api","users"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" },
                { "key": "search", "value": "",    "disabled": true },
                { "key": "status", "value": "active", "disabled": true }
              ]
            },
            "description": "Paginated user list. Optional filters: `search` (name/email ilike), `status` (active | inactive)."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"] },
            "description": "Get full user profile including region and manager."
          }
        },
        {
          "name": "Create User (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.collectionVariables.set('userId', res.data.id);",
                  "  console.log('New user id saved:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@joola.in\",\n  \"password\": \"SecurePass@123\",\n  \"phone\": \"+91 98765 43210\",\n  \"designation\": \"KPI Manager\",\n  \"department\": \"Operations\",\n  \"region_id\": \"{{regionId}}\",\n  \"is_admin\": false\n}"
            },
            "description": "Creates a Supabase Auth account + users table record. Requires admin JWT."
          }
        },
        {
          "name": "Update User (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Senior KPI Manager\",\n  \"department\": \"Strategy\"\n}"
            },
            "description": "Partial update. Only provided fields are changed. Password cannot be updated here."
          }
        },
        {
          "name": "Deactivate User (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"] },
            "description": "Sets user status to 'inactive'. Does NOT delete the record."
          }
        },
        {
          "name": "Get Direct Reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/reports", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}","reports"] },
            "description": "Returns all active users where manager_id = :id."
          }
        },
        {
          "name": "Get User's KPIs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/kpis", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}","kpis"] },
            "description": "Returns KPIs where user is owner OR contributor."
          }
        }
      ]
    },

    {
      "name": "KPIs",
      "item": [
        {
          "name": "List KPIs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/kpis?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api","kpis"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "limit",     "value": "20" },
                { "key": "status",    "value": "active",       "disabled": true },
                { "key": "owner_id",  "value": "{{userId}}",   "disabled": true },
                { "key": "region_id", "value": "{{regionId}}", "disabled": true }
              ]
            },
            "description": "Paginated KPI list ordered by level then kpi_number. Optional filters: `status`, `owner_id`, `region_id`."
          }
        },
        {
          "name": "Create KPI",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.collectionVariables.set('kpiId', res.data.id);",
                  "  console.log('kpiId saved:', res.data.kpi_number, res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis", "host": ["{{baseUrl}}"], "path": ["api","kpis"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"India Revenue Growth FY26\",\n  \"description\": \"Overall revenue growth target for India region\",\n  \"type\": \"quantitative\",\n  \"period\": \"annual\",\n  \"update_frequency\": \"monthly\",\n  \"target_value\": 1000000,\n  \"unit\": \"USD\",\n  \"start_date\": \"2026-04-01\",\n  \"end_date\": \"2027-03-31\",\n  \"allocation_pct\": 100,\n  \"region_id\": \"{{regionId}}\",\n  \"owner_id\": \"{{userId}}\"\n}"
            },
            "description": "Creates a root KPI. `region_id` is required. KPI number (e.g. KPI-IND-001) is auto-generated. New kpi id is saved to `{{kpiId}}`."
          }
        },
        {
          "name": "Get KPI by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}"] },
            "description": "Returns full KPI with owner, region, parent, and contributor details."
          }
        },
        {
          "name": "Update KPI",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_value\": 250000,\n  \"status\": \"active\"\n}"
            },
            "description": "Partial update. Changing `update_frequency` or `start_date` recalculates `next_due_date` automatically."
          }
        },
        {
          "name": "Cancel KPI",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}"] },
            "description": "Sets KPI status to 'cancelled'. Does NOT delete the record."
          }
        },
        {
          "name": "Get KPI Children",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/children", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}","children"] },
            "description": "Returns direct children of a KPI (one level down only)."
          }
        },
        {
          "name": "Get KPI Tree",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/tree", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}","tree"] },
            "description": "Returns the full recursive subtree via PostgreSQL `get_kpi_tree` RPC function. Requires 003_rpc_functions.sql to be run in Supabase."
          }
        }
      ]
    },

    {
      "name": "KPI Cascade",
      "item": [
        {
          "name": "Create Child KPI (Cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  console.log('Child KPI created:', res.data.kpi_number, res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/cascade", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}","cascade"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"North India Sales Q1\",\n  \"type\": \"quantitative\",\n  \"period\": \"quarterly\",\n  \"update_frequency\": \"monthly\",\n  \"target_value\": 300000,\n  \"unit\": \"USD\",\n  \"allocation_pct\": 30,\n  \"owner_id\": \"{{userId}}\"\n}"
            },
            "description": "Creates a child KPI under `{{kpiId}}`. `allocation_pct` is validated — sum of all children cannot exceed 100%. `region_id` is inherited from parent if not provided."
          }
        },
        {
          "name": "Get Cascade Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/cascade", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}","cascade"] },
            "description": "Returns children + `allocated_pct` + `remaining_pct` for the parent KPI."
          }
        },
        {
          "name": "Remove Child KPI",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/cascade/:childId",
              "host": ["{{baseUrl}}"],
              "path": ["api","kpis","{{kpiId}}","cascade",":childId"],
              "variable": [{ "key": "childId", "value": "CHILD_KPI_UUID_HERE" }]
            },
            "description": "Cancels the child KPI. Validates that `childId` is a child of `{{kpiId}}`."
          }
        }
      ]
    },

    {
      "name": "KPI Contributors",
      "item": [
        {
          "name": "Add / Update Contributor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/contributors", "host": ["{{baseUrl}}"], "path": ["api","kpis","{{kpiId}}","contributors"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"role\": \"contributor\",\n  \"allocation_pct\": 50\n}"
            },
            "description": "Upsert — if user is already a contributor their role/pct is updated. `role` is `owner` or `contributor`."
          }
        },
        {
          "name": "Remove Contributor",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/contributors/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api","kpis","{{kpiId}}","contributors",":userId"],
              "variable": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "Removes a contributor from the KPI."
          }
        }
      ]
    }

  ]
}
